{
  "name": "blackjack-bot",
  "productName": "Blackjack Bot",
  "private": true,
  "version": "1.0.0",
  "description": "Autonomous blackjack player — Hi-Lo counting + Illustrious 18 + Fab 4",
  "author": "Blackjack Bot",
  "main": "electron/main.cjs",
