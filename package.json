{
  "name": "atelier-magazine",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop studio for composing classy magazines and books, polished by Claude.",
  "author": "Atelier",
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env ATELIER_DEV=1 electron .",
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build",
    "build": "npm run build:renderer",
    "start": "electron .",
    "dist": "npm run build:renderer && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "vite": "^5.0.8",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.atelier.magazine",
    "productName": "Atelier Magazine",
    "files": [
      "electron/**/*",
      "dist/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Atelier-Magazine-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
